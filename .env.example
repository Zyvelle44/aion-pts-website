APP_NAME="Aion PTS 4.6"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Website database - SQL Server
DB_CONNECTION=sqlsrv
DB_HOST=127.0.0.1
DB_PORT=1433
DB_DATABASE=AionPTS_Web
DB_USERNAME=
DB_PASSWORD=
DB_TRUST_SERVER_CERTIFICATE=true

# AION game account database - SQL Server
AION_DB_CONNECTION=aion_game
AION_DB_HOST=127.0.0.1
AION_DB_PORT=1433
AION_DB_DATABASE=AionAccounts
AION_DB_USERNAME=
AION_DB_PASSWORD=
AION_DB_TRUST_SERVER_CERTIFICATE=true

# AION game server reachability check
AION_STATUS_HOST=127.0.0.1
AION_STATUS_PORT=7777
AION_STATUS_TIMEOUT=1.0
AION_STATUS_FRESHNESS_SECONDS=300
AION_STATUS_CACHE_SECONDS=30

# AION player statistics
AION_PLAYER_SERVER_IDS=1

# AION cached server
AION_CACHED_HOST=127.0.0.1
AION_CACHED_PORT=2007

# AION PTS version
AION_PTS_VERSION=1.0.0

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"